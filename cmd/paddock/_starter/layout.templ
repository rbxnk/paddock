package main

import "github.com/rbxnk/paddock/account"

templ Head(css, htmx, hxLive string) {
	<!DOCTYPE html>
	<head>
		<meta charset="utf-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1"/>
		<title>__NAME__</title>
		<link rel="stylesheet" href={ css }/>
		<script defer src={ htmx }></script>
		<script defer src={ hxLive }></script>
	</head>
}

// Page is the layout; user is nil for visitors.
templ Page(head templ.Component, user *account.User, content templ.Component) {
	@head
	<body class="bg-base-200 min-h-screen" hx-on::before:request="q('.error-tgt').innerHTML = ''">
		<header class="navbar bg-base-100 shadow-sm px-4">
			<a class="flex-1 text-lg font-bold" href="/">__NAME__</a>
			if user != nil {
				<button class="btn btn-ghost btn-sm" hx-post="/logout">Log out</button>
			} else {
				<a class="btn btn-ghost btn-sm" href="/login">Log in</a>
			}
		</header>
		<main class="max-w-3xl mx-auto p-4">
			@content
		</main>
		<div class="toast error-tgt"></div>
	</body>
}

templ Home(user *account.User) {
	if user != nil {
		<p>Signed in as { user.Email }.</p>
	} else {
		<p>Welcome. <a class="link" href="/login">Log in</a> to go on.</p>
	}
}
