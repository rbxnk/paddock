package ui

import "github.com/rbxnk/paddock/account"

type LoginPostBody struct {
	Next         string
	DevLoginAsId string
}

// The sign-in pages (kit/signin renders them inside the app's layout).

// Login signs in with email and password, or emails a sign-in link (linkSent says one went,
// whether or not the address has an account); devUsers (dev only) adds one-click logins.
templ Login(next, email, msg string, linkSent bool, devUsers []account.User) {
	<div class="flex flex-col gap-6 max-w-sm">
		<form id="login" class="flex flex-col gap-3" hx-post="/login" hx-target="#login" hx-swap="outerHTML" hx-select="#login">
			<h1 class="text-3xl font-black">Log in</h1>
			if linkSent {
				<p role="status">If { email } has an account, we've emailed it a sign-in link. It works for 15 minutes.</p>
				<a class="link text-sm" href="/login">Back to log in</a>
			} else {
				<input type="hidden" name="next" value={ next }/>
				<label class="flex flex-col gap-1">
					<span class="rec-mono text-xs opacity-60">email</span>
					<input name="email" type="email" autocomplete="email" class="input" value={ email } required autofocus/>
				</label>
				<label class="flex flex-col gap-1">
					<span class="rec-mono text-xs opacity-60">password</span>
					<input name="password" type="password" autocomplete="current-password" class="input" required/>
				</label>
				if msg != "" {
					<p class="text-error text-sm" role="alert">{ msg }</p>
				}
				<button class="btn btn-primary self-start">Log in</button>
				<button class="btn btn-outline btn-sm self-start" type="button" hx-post="/login/link" hx-target="#login" hx-swap="outerHTML" hx-select="#login">Email me a sign-in link</button>
				<a class="link text-sm" href="/forgot">Forgot your password?</a>
			}
		</form>
		if devUsers != nil {
			<div class="flex flex-col gap-2">
				<span class="rec-mono text-xs opacity-60">dev login</span>
				{{ postBody := LoginPostBody{Next: next} }}
				for _, user := range devUsers {
					{{ postBody.DevLoginAsId = user.ID }}
					<button class="btn btn-outline btn-primary btn-sm self-start" hx-post="/login_as" hx-vals={ templ.JSONString(postBody) }>
						{ user.Email }
					</button>
				}
			</div>
		}
	</div>
}

// Forgot asks for an email to send a set-password link to. sent shows the same reply
// whether or not the address has an account.
templ Forgot(sent bool) {
	<form id="forgot" class="flex flex-col gap-3 max-w-sm" hx-post="/forgot" hx-target="#forgot" hx-swap="outerHTML" hx-select="#forgot">
		<h1 class="text-3xl font-black">Forgot your password?</h1>
		if sent {
			<p role="status">If that address has an account, we've emailed it a link to set a new password. The link works for 24 hours.</p>
			<a class="link text-sm" href="/login">Back to log in</a>
		} else {
			<p>We'll email you a link to set a new password.</p>
			<label class="flex flex-col gap-1">
				<span class="rec-mono text-xs opacity-60">email</span>
				<input name="email" type="email" autocomplete="email" class="input" required autofocus/>
			</label>
			<button class="btn btn-primary self-start">Send link</button>
		}
	</form>
}

// SetPassword is where invite and reset emails land. ok is false when the link has expired
// or was already used.
templ SetPassword(token string, ok bool, msg string) {
	<form id="setpw" class="flex flex-col gap-3 max-w-sm" hx-post="/reset" hx-target="#setpw" hx-swap="outerHTML" hx-select="#setpw">
		<h1 class="text-3xl font-black">Set your password</h1>
		<input type="hidden" name="t" value={ token }/>
		if !ok {
			<p role="alert">This link has expired or was already used.</p>
			<a class="link text-sm" href="/forgot">Send a new link</a>
		} else {
			<label class="flex flex-col gap-1">
				<span class="rec-mono text-xs opacity-60">new password (8 or more characters)</span>
				<input name="password" type="password" autocomplete="new-password" minlength="8" maxlength="72" class="input" required autofocus/>
			</label>
			if msg != "" {
				<p class="text-error text-sm" role="alert">{ msg }</p>
			}
			<button class="btn btn-primary self-start">Save and log in</button>
		}
	</form>
}

// SignInLink is where a sign-in email lands; ok is false when the link has expired or was
// already used.
templ SignInLink(token string, ok bool) {
	<form id="signin" class="flex flex-col gap-3 max-w-sm" hx-post="/signin" hx-target="#signin" hx-swap="outerHTML" hx-select="#signin">
		<h1 class="text-3xl font-black">Log in</h1>
		if ok {
			<p>Press the button to finish logging in.</p>
			<input type="hidden" name="t" value={ token }/>
			<button class="btn btn-primary self-start" autofocus>Log in</button>
		} else {
			<p role="alert">This link has expired or was already used.</p>
			<a class="link text-sm" href="/login">Back to log in</a>
		}
	</form>
}

